# Copy this file to .env and paste your key:
#   cp .env.example .env
# Get a key at https://bloomwatch.co/settings#api-keys (API plan).
# Never commit .env, it is gitignored.

BLOOMWATCH_KEY=bw_live_your_key_here

# Optional: point at another server (default https://bloomwatch.co)
# BLOOMWATCH_URL=http://localhost:3001
